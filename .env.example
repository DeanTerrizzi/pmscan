# Copy to .env (git-ignored) and fill in what you use. Everything is optional.

# Sportsbook comparison: key from https://the-odds-api.com
PMSCAN_ODDS_API_KEY=

# Alerts: Telegram (create a bot with @BotFather, then get your chat id)...
PMSCAN_TELEGRAM_BOT_TOKEN=
PMSCAN_TELEGRAM_CHAT_ID=
# ...and/or Discord (Server Settings > Integrations > Webhooks)
PMSCAN_DISCORD_WEBHOOK_URL=

# Live trading only (the Mac app keeps these in the Keychain instead; see README).

# --- Polymarket US (polymarket.us) ---
# An API key from polymarket.us/developer (after ID verification in the app).
# PMSCAN_VENUE=us makes Polymarket US the default exchange for every command.
# PMSCAN_VENUE=us
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=

# --- polymarket.com (international) ---
# POLYMARKET_PRIVATE_KEY is the key the bot signs orders with: ideally a session key, which
# `pmscan trade authorize-session` creates and writes here for you.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
# Your account's owner key, only while running `pmscan trade authorize-session`; delete it after.
POLYMARKET_OWNER_PRIVATE_KEY=
# Relayer API key (polymarket.com > Settings > API Keys) for gasless approvals in `pmscan trade setup`
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
